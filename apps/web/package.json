{
  "name": "mlm-dx-web",
  "version": "1.0.0",
  "private": true,
  "description": "MLM-DX Next.js frontend",
  "scripts": {
    "dev": "vite dev --port 8787",
    "build": "NODE_ENV=production vite build",
    "preview": "pnpm run build && vite preview --port 8787",
    "dry-run": "pnpm run build && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:create": "wrangler d1 create mlm-dx-db",
    "db:migrate:prod": "wrangler d1 migrations apply mlm-dx-db --env production --remote",
    "db:reset:prod": "wrangler d1 execute mlm-dx-db --env production --remote --file=../worker/schema.sql",
    "lint": "eslint app components hooks lib types middleware.ts worker.ts vite.config.ts vinext-env.d.ts --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.4",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/types": "^11.0.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.546.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-big-calendar": "^1.15.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vinext": "1.4.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/react": "19.3.0",
    "@types/react-big-calendar": "^1.16.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.16",
    "next": "^16.4.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "4.160.0"
  },
  "type": "module"
}
