{
  "name": "mlm-dx-worker",
  "version": "1.0.0",
  "private": true,
  "description": "MLM-DX Cloudflare Workers backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "tsc --noEmit",
    "db:create": "wrangler d1 create mlm-dx-db",
    "db:migrate": "wrangler d1 migrations apply mlm-dx-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply mlm-dx-db --local",
    "db:reset": "wrangler d1 execute mlm-dx-db --file=./schema.sql",
    "db:reset:local": "wrangler d1 execute mlm-dx-db --file=./schema.sql --local",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "pnpm run check:boundaries && vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "date-fns": "^3.6.0",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0",
    "@types/node": "^26.6.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
